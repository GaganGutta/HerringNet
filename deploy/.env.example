# Copy to deploy/.env and fill in. Do NOT commit the real .env.

# Your domain name, pointed at the VM's IP (an A record).
DOMAIN=herring.example.org

# Where the database and images live on the VM. Point this at your mounted
# storage volume, e.g. /mnt/herring-data. Defaults to ./data if unset.
DATA_DIR=/mnt/herring-data

# Shared-password gate for the viewer + upload page (NOT a full login system).
# Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-password-here'
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=replace-with-bcrypt-hash

# Label Studio shared account (one login the team can share).
LS_USERNAME=team@herring.local
LS_PASSWORD=change-me
LS_TOKEN=change-me-long-random-token
LS_DB_PASSWORD=change-me-db-password
